---
/**
 * Блок «Проверь себя» в конце главы.
 * Внутрь кладутся <QuizItem q="Вопрос">Ответ</QuizItem>.
 */
interface Props {
  title?: string;
}

const { title = 'Проверь себя' } = Astro.props;
---

<section class="mojo-quiz not-content">
  <h3 class="mojo-quiz__title">🎯 {title}</h3>
  <slot />
</section>
