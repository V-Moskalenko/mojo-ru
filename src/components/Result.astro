---
/**
 * Блок вывода программы. Ставится сразу под блоком кода.
 *
 * Содержимое НЕ пишется руками: оно генерируется скриптом
 * `npm run examples:run`, который запускает пример на реальном компиляторе
 * Mojo и подставляет фактический вывод. Так вывод на сайте не может
 * разойтись с реальностью.
 *
 * <Result>
 * Привет, Mojo!
 * </Result>
 *
 * ВАЖНО. Содержимое по умолчанию проходит через разбор Markdown, поэтому
 * годится только для простого вывода. Передавайте вывод пропом `output`,
 * если в нём есть:
 *
 *   - отступы (подряд идущие пробелы схлопываются в один);
 *   - строки вида «1.», «2.» или «- » в начале (превращаются в список).
 *
 * Проп пишется ОДНОЙ строкой с экранированными переводами строк:
 *
 *   <Result output={"первая\nвторая\n   с отступом"} />
 *
 * Многострочный шаблонный литерал (в обратных кавычках) внутри MDX
 * тоже теряет отступы — проверено, так делать нельзя.
 */
interface Props {
  /** Подпись слева. По умолчанию — «Результат». */
  label?: string;
  /**
   * Текст вывода. Альтернатива содержимому по умолчанию: внутри списков
   * и шагов многострочное выражение ломает разбор MDX, поэтому там вывод
   * передаётся пропом.
   */
  output?: string;
}

const { label = 'Результат', output } = Astro.props;
---

<div class="mojo-result not-content">
  <div class="mojo-result__label">{label}</div>
  <pre>{output ? output : <slot />}</pre>
</div>
